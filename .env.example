# Yantresh Commerce — env template. Real values live in the yantresh-hub .env.
# Rule 2: never inline a real domain/secret in code — read these as variables.

# Edge / deploy plane (yantresh-hub)
DOMAIN=example.com
ACME_EMAIL=ops@example.com
GHCR_OWNER=your-gh-owner

# Service hostnames (avoid `api.` collision with yantresh-os)
SHOP_API_ADDRESS=shop-api.${DOMAIN}
SHOP_ADMIN_ADDRESS=shop-admin.${DOMAIN}
COMMERCE_STOREFRONT_ADDRESS=commerce.${DOMAIN}
DEMO_STORE_ADDRESS=demo-store.${DOMAIN}
STOREFRONT_TLS_ASK_URL=http://yantresh-commerce-storefront:3000/api/tls/authorize

# Data
DATABASE_URL=postgres://USER:PASSWORD@postgres:5432/yantresh_control
MEDUSA_DATABASE_URL=postgres://USER:PASSWORD@postgres:5432/medusa
REDIS_URL=redis://redis:6379

# Secrets envelope (master key held OUTSIDE the DB; never commit the real value)
SECRET_MASTER_KEY=

# Demo tenant bootstrap
DEMO_TENANT_SLUG=demo-store
DEMO_TENANT_NAME=Yantresh Demo Store
DEMO_SALES_CHANNEL_ID=demo-sales-channel
DEMO_REGION_ID=demo-region
DEMO_PUBLISHABLE_KEY_REF=demo-publishable-key
