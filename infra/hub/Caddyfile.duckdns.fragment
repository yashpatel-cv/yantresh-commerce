# Optional temporary storefront host while `*.${DOMAIN}` is not live yet.
#
# Example env:
#   TEMP_STOREFRONT_ADDRESS=yecom.duckdns.org
#
# Keep OpenClaw on its own hostname, for example:
#   pclaw.duckdns.org -> OpenClaw
#   yecom.duckdns.org -> Yantresh Commerce storefront
#
# This reuses the same public 80/443 with host-based routing; no extra port is needed.

{$TEMP_STOREFRONT_ADDRESS} {
  reverse_proxy yantresh-commerce-storefront:3000
}
